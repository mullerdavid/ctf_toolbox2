[Unit]
Description=CTF A/D exploit runner and flag submitter
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/ctf-ad-submitter
ExecStart=/usr/bin/python3 -m submitter --config /opt/ctf-ad-submitter/config.py
ExecReload=/bin/kill -HUP $MAINPID
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=3
# SIGTERM to the submitter (it kills running exploits), then SIGKILL to leftovers.
KillMode=mixed
TimeoutStopSec=10
# User=ctf

[Install]
WantedBy=multi-user.target
